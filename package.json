{
  "name": "imaxt",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun run --filter='./packages/*' build",
    "test": "bun test",
    "typecheck": "bun run --filter='./packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "bun scripts/publish.ts",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint",
    "pre-push": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "happy-dom": "20.14.6",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  }
}
