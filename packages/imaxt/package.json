{
  "name": "@inflate-ai/imaxt",
  "version": "1.0.0",
  "description": "Framework-neutral typographic blocks and a native React editor.",
  "type": "module",
  "license": "MIT",
  "author": "Inflate AI",
  "homepage": "https://github.com/Inflate-AI/Imaxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inflate-AI/Imaxt.git",
    "directory": "packages/imaxt"
  },
  "bugs": "https://github.com/Inflate-AI/Imaxt/issues",
  "keywords": [
    "imaxt",
    "typography",
    "article",
    "blocks",
    "editor",
    "lexical"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./styles.css": "./dist/styles.css",
    "./editor.css": "./dist/editor.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/core.ts ./src/editor.ts --outdir dist --target browser --format esm --sourcemap=external --packages=external && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir dist && cp src/styles.css dist/styles.css && cp src/editor/theme/editor.css dist/editor.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --preload ../../test/happydom.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@lexical/code": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/utils": "0.52.0",
    "katex": "0.16.21",
    "lexical": "0.52.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "mermaid": "^12.1.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-mdxjs": "3.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lexical/headless": "0.52.0",
    "@types/katex": "^0.16.8",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "bun-types": "1.4.3",
    "happy-dom": "20.14.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "7.0.2"
  }
}
