---
import {
  ImaxtCover,
  imaxt,
} from '../../../src/index.ts';

const {
  Statement,
  PullQuote,
  Sidenote,
  Bars,
  Ranked,
  Matrix,
  Delta,
  Gauge,
  Scorecard,
  Sparkline,
  Funnel,
  Callout,
  Faq,
  Takeaways,
  Footnote,
  Glossary,
  Versus,
  Checklist,
  Terminal,
  Diff,
  FileTree,
  ErrorBox,
  Changelog,
  Marquee,
  Heatmap,
  CurvedText,
  TypeLab,
  StatRow,
  Stat,
  Compare,
  Side,
  Steps,
  Step,
  Timeline,
  Event,
  Scrolly,
  Beat,
  CodeWalk,
} = imaxt;
---

<html lang="en">
  <head><meta charset="utf-8" /><title>Imaxt test site</title></head>
  <body>
    <Statement tone="mint" align="center">Boring is <em>dependable</em>.</Statement>

    <PullQuote by="Design rule">The best API is a short one.</PullQuote>

    <Sidenote label="Mock data">Numbers here are placeholders.</Sidenote>

    <Bars unit="%" tone="accent" items={[{ label: 'Model A', value: 72 }, { label: 'Model B', value: 81 }]} />

    <Ranked items={[{ label: 'Model A', value: '92', delta: 3 }, { label: 'Model B', value: '88', delta: 'new' }]} />

    <Matrix
      rows={['Free', 'Pro']}
      cols={['Exports']}
      cells={[['no'], ['yes']]}
      caption="Plan comparison"
    />

    <Delta label="Latency" from={120} to={80} unit="ms" />

    <Gauge value={42} max={100} label="Capacity" unit="%" />

    <Scorecard items={[{ label: 'MRR', value: 42000, unit: '$' }, { label: 'Churn', value: '2.1', unit: '%' }]} />

    <Sparkline values={[12, 18, 9, 24]} label="Weekly signups" />

    <Funnel stages={[{ label: 'Visitors', value: 1000 }, { label: 'Signups', value: 500 }]} />

    <Callout kind="tip" title="Heads up">Callouts need no icons.</Callout>

    <Faq items={[{ q: 'Is this free?', a: 'Yes.' }]} />

    <Takeaways title="Key takeaways" items={['First point', 'Second point']} />

    <Footnote marker="1">A citation goes here.</Footnote>

    <Glossary items={[{ term: 'RAG', definition: 'Retrieval-augmented generation' }]} />

    <Versus sides={[{ label: 'Postgres', html: 'Relational' }, { label: 'SQLite', html: 'Embedded' }]} />

    <Checklist title="Launch checklist" items={[{ text: 'Write tests', done: true }, { text: 'Ship it' }]} />

    <Terminal title="Setup" lines={[{ command: 'npm install' }, { output: 'added 42 packages' }]} />

    <Diff before={"const a = 1;"} after={"const a = 2;"} />

    <FileTree tree={[{ name: 'src', children: [{ name: 'index.ts' }] }]} />

    <ErrorBox title="TypeError" message="Cannot read property 'x'" stack={"    at foo (file.ts:1:1)"} />

    <Changelog entries={[{ version: '0.2.0', date: '2026-10-11', items: ['Added X'] }]} />

    <Marquee words={['Embed', 'Filter', 'Rank']} tone="accent" />

    <Heatmap
      caption="Common modes"
      rows={['600', '644']}
      cols={['Owner', 'Others']}
      data={[[6, 0], [6, 4]]}
      min={0}
      max={7}
    />

    <CurvedText text="Drafted" shape="circle" mark="D" tone="mint" spin decorative />

    <TypeLab sample="Same letters, different voice" />

    <StatRow>
      <Stat value="5" unit="ms" label="p95 query time" tone="mint" />
      <Stat value="10×" label="fewer calls" tone="sky" />
    </StatRow>

    <Compare>
      <Side kind="before" label="Before">Three pipelines, three sets of bugs</Side>
      <Side label="After">One small API, one set of bugs</Side>
    </Compare>

    <Steps>
      <Step title="Chunk">Split each document into pieces.</Step>
      <Step title="Embed">Turn every chunk into a vector.</Step>
    </Steps>

    <Timeline>
      <Event date="Step 1" title="Propose">A leader suggests a value.</Event>
      <Event date="Step 2" title="Accept">A majority accepts it.</Event>
    </Timeline>

    <Scrolly tone="sky">
      <Beat stage="Chunk" sub="step 1">Split each document into pieces.</Beat>
      <Beat stage="Embed" sub="step 2">Turn every chunk into a vector.</Beat>
    </Scrolly>

    <CodeWalk
      code={"const id = `${doc.id}`;\nawait index.upsert({ id, vector });"}
      steps={[{ lines: '1', title: 'Stable id', text: 'Same chunk, same id.' }, { lines: '2', title: 'Upsert' }]}
    />

    <CodeWalk steps={[{ lines: '1', title: 'Slotted' }]}>
      <pre class="fixture-highlighted"><code><span class="line">const slotted = true;</span></code></pre>
    </CodeWalk>

    <ImaxtCover title="One API for every vector" tone="mint" ratio="4 / 3" />
  </body>
</html>
