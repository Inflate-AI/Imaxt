{
  "name": "@inflate-ai/imaxt-editorjs",
  "version": "0.1.0",
  "description": "EditorJS block tools for Imaxt's typographic article blocks.",
  "type": "module",
  "license": "MIT",
  "author": "Inflate AI",
  "homepage": "https://github.com/Inflate-AI/Imaxt/tree/main/packages/editorjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inflate-AI/Imaxt.git",
    "directory": "packages/editorjs"
  },
  "bugs": "https://github.com/Inflate-AI/Imaxt/issues",
  "keywords": [
    "imaxt",
    "editorjs",
    "editor.js",
    "blocks",
    "wysiwyg"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target browser --format esm --sourcemap=external --external @editorjs/editorjs && tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@inflate-ai/imaxt-core": "workspace:*"
  },
  "peerDependencies": {
    "@editorjs/editorjs": "^2.31.7"
  },
  "devDependencies": {
    "@editorjs/editorjs": "2.31.7",
    "@types/node": "26.6.5",
    "happy-dom": "20.14.6",
    "typescript": "7.0.2"
  }
}
