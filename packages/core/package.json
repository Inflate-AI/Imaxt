{
  "name": "@inflate-ai/imaxt-core",
  "version": "0.4.0",
  "description": "Framework-agnostic render engine, design tokens and interactivity for Imaxt's typographic article blocks.",
  "type": "module",
  "license": "MIT",
  "author": "Inflate AI",
  "homepage": "https://github.com/Inflate-AI/Imaxt/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inflate-AI/Imaxt.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/Inflate-AI/Imaxt/issues",
  "keywords": [
    "imaxt",
    "typography",
    "article",
    "blocks",
    "editorjs",
    "astro"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target browser --format esm --sourcemap=external --packages=external && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir dist && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "katex": "0.16.21"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "26.6.5",
    "bun-types": "1.4.3",
    "happy-dom": "20.14.6",
    "typescript": "7.0.2"
  }
}
