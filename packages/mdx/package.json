{
  "name": "@inflate-ai/imaxt-mdx",
  "version": "0.3.0",
  "description": "Bidirectional compiler between Imaxt EditorJS block JSON and MDX source.",
  "type": "module",
  "license": "MIT",
  "author": "Inflate AI",
  "homepage": "https://github.com/Inflate-AI/Imaxt/tree/main/packages/mdx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inflate-AI/Imaxt.git",
    "directory": "packages/mdx"
  },
  "bugs": "https://github.com/Inflate-AI/Imaxt/issues",
  "keywords": [
    "imaxt",
    "mdx",
    "editorjs",
    "compiler",
    "markdown"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node --format esm --sourcemap=external --packages=external && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@inflate-ai/imaxt-core": "workspace:*",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/unist": "3.0.3",
    "bun-types": "1.4.3",
    "typescript": "7.0.2"
  }
}
